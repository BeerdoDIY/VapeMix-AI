rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ===============================================================
    // Validation Blueprints
    // ===============================================================

    function isValidRecipe(data) {
      return data.uid == request.auth.uid &&
             data.id is string &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100;
    }

    function isValidInventory(data) {
      return data.uid == request.auth.uid &&
             data.name is string && data.name.size() > 0;
    }

    function isValidShoppingItem(data) {
      return data.uid == request.auth.uid &&
             data.id is string &&
             data.name is string && data.name.size() > 0;
    }

    function isValidSettings(data) {
      return data.uid == request.auth.uid;
    }

    function isValidMix(data) {
      return data.uid == request.auth.uid &&
             data.id is string &&
             data.recipeId is string;
    }

    function isValidOrder(data) {
      return data.uid == request.auth.uid &&
             data.id is string &&
             data.status in ['pending', 'received'];
    }

    // ===============================================================
    // Collection Paths
    // ===============================================================

    // Path for connection testing - PUBLIC READ to avoid errors on boot
    match /test/{docId} {
      allow read: if true;
    }

    match /users/{uid} {
      // User profile potentially readable by owner
      allow read: if isOwner(uid);

      match /recipes/{recipeId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isValidRecipe(incoming()) 
                      && incoming().keys().hasAll(['id', 'name', 'uid'])
                      && incoming().keys().size() >= 3;
        allow update: if isOwner(uid) && isValidRecipe(incoming())
                      && incoming().uid == existing().uid;
        allow delete: if isOwner(uid);
      }

      match /inventory/{flavorName} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidInventory(incoming());
        allow delete: if isOwner(uid);
      }

      match /shoppingList/{itemId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidShoppingItem(incoming());
        allow delete: if isOwner(uid);
      }

      match /settings/{docId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidSettings(incoming());
        allow delete: if isOwner(uid);
      }

      match /mixes/{mixId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidMix(incoming());
        allow delete: if isOwner(uid);
      }

      match /orders/{orderId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidOrder(incoming());
        allow delete: if isOwner(uid);
      }
    }
  }
}
